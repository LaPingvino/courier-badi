  args = 
# Generating ../fonts/webfonts/CourierBadi[ital,wght].woff2
build ../fonts/webfonts/CourierBadi[ital,wght].woff2: compress $
    /tmp/tmp3mwhmy_h
  operation = compress
# Generating ../fonts/variable/CourierBadi-Italic[wght].ttf
build ../fonts/variable/CourierBadi-Italic[wght].ttf: copy /tmp/tmp3mwhmy_h
# Generating /tmp/tmpl9azraop
build /tmp/tmpl9azraop: buildTTF instance_ufos/CourierBadi-Regular.ufo.json
  operation = buildTTF
  args = --filter ...  --filter FlattenComponentsFilter --filter $
      DecomposeTransformedComponentsFilter
  fontmake_type = -u
  fontmake_args =  --verbose WARNING 
# Generating /tmp/tmpqvn6e7g_
build /tmp/tmpqvn6e7g_: buildOTF instance_ufos/CourierBadi-Regular.ufo.json
