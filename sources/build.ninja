# buildVariable: Build a variable font from a source file
rule buildVariable
  command = /home/joop/Projects/courier-badi/venv/bin/python3 -m $
      gftools.builder.jobrunner fontmake --output-path $out -o variable $
      $fontmake_type $in $args $stamp
  description = buildVariable

# subspace: Run varLib.instancer to subspace a variable font
rule subspace
  command = /home/joop/Projects/courier-badi/venv/bin/python3 -m $
      gftools.builder.jobrunner fonttools varLib.instancer $args -o $out $
      $in $axes $stamp
  description = subspace

# fix: Run gftools-fix
rule fix
  command = /home/joop/Projects/courier-badi/venv/bin/python3 -m $
      gftools.builder.jobrunner gftools-fix-font -o $out $args $in $stamp
  description = fix

# exec: Run an arbitrary executable
rule exec
  command = /home/joop/Projects/courier-badi/venv/bin/python3 -m $
      gftools.builder.jobrunner $exe $args $stamp
  description = exec

# compress: Compress to webfont
rule compress
  command = /home/joop/Projects/courier-badi/venv/bin/python3 -m $
      gftools.builder.jobrunner fonttools ttLib.woff2 compress -o $out $in $
      $stamp
  description = compress

# buildStat: Build a STAT table from one or more source files
rule buildSTAT-operation
  command = gftools-gen-stat --out $tempdir $args -- $in && mv $finalfile $
      $out $stamp
rule buildSTAT-postprocess
  command = gftools-gen-stat --inplace $args -- $in $stamp

# instantiateUfo: Create instance UFOs from a Glyphs or designspace file
rule instantiateUfo
  command = /home/joop/Projects/courier-badi/venv/bin/python3 -m $
      gftools.builder.jobrunner fontmake -i "$instance_name" -o ufo $
      $fontmake_type $in $args $stamp
  description = instantiateUfo

# buildTTF: Build a TTF from a source file
rule buildTTF
  command = /home/joop/Projects/courier-badi/venv/bin/python3 -m $
      gftools.builder.jobrunner fontmake --output-path $out -o ttf $
      $fontmake_type $in $args $stamp
  description = buildTTF

# autohint: Run gftools-autohint
rule autohint
  command = /home/joop/Projects/courier-badi/venv/bin/python3 -m $
      gftools.builder.jobrunner gftools-autohint $args -o $out $in $stamp
  description = autohint

# buildOTF: Build a OTF from a source file
rule buildOTF
  command = /home/joop/Projects/courier-badi/venv/bin/python3 -m $
      gftools.builder.jobrunner fontmake --output-path $out -o otf $
      $fontmake_type $in $args $stamp
  description = buildOTF

# copy: Copy a file
rule copy
  command = /home/joop/Projects/courier-badi/venv/bin/python3 -m $
      gftools.builder.jobrunner cp $in $out $stamp
  description = copy

# Generating /tmp/tmp_23dsl5i
build /tmp/tmp_23dsl5i: buildVariable CourierBadi.designspace
  operation = buildVariable
  args = --filter ...  --filter FlattenComponentsFilter --filter $
      DecomposeTransformedComponentsFilter
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
# Generating instance_ufos/CourierBadi-Regular.ufo.json
build instance_ufos/CourierBadi-Regular.ufo.json: instantiateUfo $
    CourierBadi.designspace
  operation = instantiateUfo
  instance_name = Courier Badi Regular
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
  args =  --ufo-structure=json --output-dir instance_ufos
# Generating instance_ufos/CourierBadi-Bold.ufo.json
build instance_ufos/CourierBadi-Bold.ufo.json: instantiateUfo $
    CourierBadi.designspace
  operation = instantiateUfo
  instance_name = Courier Badi Bold
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
  args =  --ufo-structure=json --output-dir instance_ufos
# Generating instance_ufos/CourierBadi-Italic.ufo.json
build instance_ufos/CourierBadi-Italic.ufo.json: instantiateUfo $
    CourierBadi.designspace
  operation = instantiateUfo
  instance_name = Courier Badi Italic
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
  args =  --ufo-structure=json --output-dir instance_ufos
# Generating instance_ufos/CourierBadi-BoldItalic.ufo.json
build instance_ufos/CourierBadi-BoldItalic.ufo.json: instantiateUfo $
    CourierBadi.designspace
  operation = instantiateUfo
  instance_name = Courier Badi Bold Italic
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
  args =  --ufo-structure=json --output-dir instance_ufos
# Postprocessing  with BuildSTAT
build /tmp/tmpykuvghub.buildStatstamp: buildSTAT-postprocess $
    ../fonts/variable/CourierBadi[wght].ttf $
    ../fonts/variable/CourierBadi-Italic[wght].ttf | $
    ../fonts/variable/CourierBadi[wght].ttf $
    ../fonts/variable/CourierBadi-Italic[wght].ttf
  stamp =  && touch /tmp/tmpykuvghub.buildStatstamp
  postprocess = buildStat
# Generating ../fonts/webfonts/CourierBadi-Regular.woff2
build ../fonts/webfonts/CourierBadi-Regular.woff2: compress $
    ../fonts/ttf/CourierBadi-Regular.ttf
  operation = compress
# Generating ../fonts/webfonts/CourierBadi-Bold.woff2
build ../fonts/webfonts/CourierBadi-Bold.woff2: compress $
    ../fonts/ttf/CourierBadi-Bold.ttf
  operation = compress
