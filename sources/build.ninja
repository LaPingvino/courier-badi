  args = 
# Generating /tmp/tmpa39ezxwl
build /tmp/tmpa39ezxwl: exec /tmp/tmp_5j8qczy
  exe = gftools-fontsetter
  args = -o /tmp/tmpa39ezxwl /tmp/tmp_5j8qczy /tmp/tmpcpem82te
# Generating /tmp/tmpc9dbvim2
build /tmp/tmpc9dbvim2: fix /tmp/tmpa39ezxwl
  operation = fix
  args = --include-source-fixes
# Generating /tmp/tmp9l9ux4nr
build /tmp/tmp9l9ux4nr: fix /tmp/tmpc9dbvim2
