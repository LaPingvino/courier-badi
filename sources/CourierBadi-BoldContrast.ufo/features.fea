#----------------------------------------------------------------------------------


lookup abvs_02 { 

	sub aCandraDeva' lookup a_vowel anusvDeva' lookup eCandra_anusvara;
	sub aCandraDeva' lookup a_vowel cBinduDeva' lookup eCandra_candraBindu;
	sub aShortDeva' lookup a_vowel anusvDeva' lookup eShortMatra_anusvara;
	sub aShortDeva' lookup a_vowel cBinduDeva' lookup eShortMatra_candraBindu;
	sub aShortDeva' lookup a_vowel rephDeva' lookup eShortMatra_reph;					
	sub aCandraDeva' lookup a_vowel rephDeva' lookup eCandra_reph;					
	sub oeDeva' lookup a_vowel anusvDeva' lookup oeMatra_anusvara;
	sub oeDeva' lookup a_vowel cBinduDeva' lookup oeMatra_candraBindu;
	
	sub aiDeva' lookup e_vowel anusvDeva' lookup eMatra_anusvara;
	sub eCandDeva' lookup e_vowel anusvDeva' lookup eCandra_anusvara;
	sub eShDeva' lookup e_vowel anusvDeva' lookup eShortMatra_anusvara;
	sub ayDeva' lookup e_vowel anusvDeva' lookup ayMatra_anusvara;
	sub aiDeva' lookup e_vowel cBinduDeva' lookup eMatra_candraBindu;
	sub eCandDeva' lookup e_vowel cBinduDeva' lookup eCandra_candraBindu;
	sub eShDeva' lookup e_vowel cBinduDeva' lookup eShortMatra_candraBindu;
	sub ayDeva' lookup e_vowel cBinduDeva' lookup ayMatra_candraBindu;
	sub aiDeva' lookup e_vowel rephDeva' lookup eMatra_reph;							
	sub eCandDeva' lookup e_vowel rephDeva' lookup eCandra_reph;					
	sub eShDeva' lookup e_vowel rephDeva' lookup eShortMatra_reph;					
	
	sub oDeva' lookup aa_vowel anusvDeva' lookup eMatra_anusvara;
	sub auDeva' lookup aa_vowel anusvDeva' lookup aiMatra_anusvara;
	sub oCandraDeva' lookup aa_vowel anusvDeva' lookup eCandra_anusvara;
	sub oCandraDeva' lookup aa_vowel cBinduDeva' lookup eCandra_candraBindu;
	sub oShortDeva' lookup aa_vowel anusvDeva' lookup eShortMatra_anusvara;
	sub oDeva' lookup aa_vowel cBinduDeva' lookup eMatra_candraBindu;
	sub auDeva' lookup aa_vowel cBinduDeva' lookup aiMatra_candraBindu;
	sub oShortDeva' lookup aa_vowel cBinduDeva' lookup eShortMatra_candraBindu;
	sub oDeva' lookup aa_vowel rephDeva' lookup eMatra_reph;							
	sub auDeva' lookup aa_vowel rephDeva' lookup aiMatra_reph;						
	sub oCandraDeva' lookup aa_vowel rephDeva' lookup eCandra_reph;					
	sub oShortDeva' lookup aa_vowel rephDeva' lookup eShortMatra_reph;				
	sub ooeDeva' lookup aa_vowel anusvDeva' lookup oeMatra_anusvara;
	sub awDeva' lookup aa_vowel anusvDeva' lookup ayMatra_anusvara;
	sub ooeDeva' lookup aa_vowel cBinduDeva' lookup oeMatra_candraBindu;
	sub awDeva' lookup aa_vowel cBinduDeva' lookup ayMatra_candraBindu;

	sub iiDeva' lookup i_vowel anusvDeva' lookup reph_anusvara;
	sub iiDeva' lookup i_vowel cBinduDeva' lookup reph_candraBindu;
	
	sub oMatraDeva' lookup aa_matra anusvDeva' lookup eMatra_anusvara;
	sub auMatraDeva' lookup aa_matra anusvDeva' lookup aiMatra_anusvara;
	sub oCandraMatraDeva' lookup aa_matra anusvDeva' lookup eCandra_anusvara;
	sub oShortMatraDeva' lookup aa_matra anusvDeva' lookup eShortMatra_anusvara;
	sub ooeMatraDeva' lookup aa_matra anusvDeva' lookup oeMatra_anusvara;
	sub awMatraDeva' lookup aa_matra anusvDeva' lookup ayMatra_anusvara;
	
	sub oMatraDeva' lookup aa_matra rephDeva' lookup eMatra_reph;
	sub auMatraDeva' lookup aa_matra rephDeva' lookup aiMatra_reph;
	sub oCandraMatraDeva' lookup aa_matra rephDeva' lookup eCandra_reph;
	sub oShortMatraDeva' lookup aa_matra rephDeva' lookup eShortMatra_reph;
	sub ooeMatraDeva' lookup aa_matra rephDeva' lookup oeMatra_reph;
	sub awMatraDeva' lookup aa_matra rephDeva' lookup ayMatra_reph;
	
	sub oMatraDeva' lookup aa_matra reph_anusvDeva' lookup eMatra_reph_anusvara;
	sub auMatraDeva' lookup aa_matra reph_anusvDeva' lookup aiMatra_reph_anusvara;
	sub oCandraMatraDeva' lookup aa_matra reph_anusvDeva' lookup eCandra_reph_anusvara;
	sub oShortMatraDeva' lookup aa_matra reph_anusvDeva' lookup eShortMatra_reph_anusvara;
	sub ooeMatraDeva' lookup aa_matra reph_anusvDeva' lookup oeMatra_reph_anusvara;
	sub awMatraDeva' lookup aa_matra reph_anusvDeva' lookup ayMatra_reph_anusvara;
	
	sub oMatraDeva' lookup aa_matra cBinduDeva' lookup eMatra_candraBindu;
	sub auMatraDeva' lookup aa_matra cBinduDeva' lookup aiMatra_candraBindu;
	sub oCandraMatraDeva' lookup aa_matra cBinduDeva' lookup eCandra_candraBindu;
	sub oShortMatraDeva' lookup aa_matra cBinduDeva' lookup eShortMatra_candraBindu;
	sub ooeMatraDeva' lookup aa_matra cBinduDeva' lookup oeMatra_candraBindu;
	sub awMatraDeva' lookup aa_matra cBinduDeva' lookup ayMatra_candraBindu;

	sub oMatraDeva' lookup aa_matra reph_cBinduDeva' lookup eMatra_reph_candraBindu;
	sub auMatraDeva' lookup aa_matra reph_cBinduDeva' lookup aiMatra_reph_candraBindu;
	sub oCandraMatraDeva' lookup aa_matra reph_cBinduDeva' lookup eCandra_reph_candraBindu;
	sub oShortMatraDeva' lookup aa_matra reph_cBinduDeva' lookup eShortMatra_reph_candraBindu;	
	sub ooeMatraDeva' lookup aa_matra reph_cBinduDeva' lookup oeMatra_reph_candraBindu;
	sub awMatraDeva' lookup aa_matra reph_cBinduDeva' lookup ayMatra_reph_candraBindu;
} abvs_02 ;


