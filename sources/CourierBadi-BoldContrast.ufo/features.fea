	sub [shDeva shDeva.MAR] cDeva by sh_cDeva;
	sub shDeva laDeva by sh_laDeva;
	sub [shDeva shDeva.MAR] vaDeva by sh_vaDeva;
	sub [shDeva shDeva.MAR] vDeva by sh_vDeva;
