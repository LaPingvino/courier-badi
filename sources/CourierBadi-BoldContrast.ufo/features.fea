lookup matra_to_nuktaMatra_split {	
	sub uMatraDeva by nuktaDeva.alt uMatraDeva.alt;
	sub uuMatraDeva by nuktaDeva.alt uuMatraDeva.alt;
	sub ueMatraDeva by nuktaDeva.alt ueMatraDeva.alt;
	sub uueMatraDeva by nuktaDeva.alt uueMatraDeva.alt;
} matra_to_nuktaMatra_split ;



#-------------------------------------------------------------------------
# 		Lookups for Consonant + Nukta + Below-base Mark glyphs
#		Mentioned in BLWS
#-------------------------------------------------------------------------

lookup nukta_to_uMatra {
	sub nuktaDeva by uMatraDeva;
} nukta_to_uMatra ;

lookup nukta_to_uuMatra {
	sub nuktaDeva by uuMatraDeva;
} nukta_to_uuMatra ;

lookup nukta_to_rMatra {
	sub nuktaDeva by rVocMatraDeva;
} nukta_to_rMatra ;

lookup nukta_to_rrMatra {
	sub nuktaDeva by rrVocMatraDeva;
} nukta_to_rrMatra ;

lookup matra_to_nukta {
	sub rrVocMatraDeva by nuktaDeva;
	sub rVocMatraDeva by nuktaDeva;
	sub uMatraDeva by nuktaDeva;
	sub uuMatraDeva by nuktaDeva;
} matra_to_nukta ;


