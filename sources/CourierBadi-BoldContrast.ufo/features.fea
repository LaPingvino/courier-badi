} pres;

feature abvs {
#----------------------------------------------------------------------------------
# 		Lookup for reordering Visarga & Udatta
#----------------------------------------------------------------------------------


lookup reorder_udatta {
	sub visargaDeva' lookup visarga_to_NullMark udattaDeva' lookup reorder_visarga;
	sub visargaDeva' lookup visarga_to_NullMark @VedicTopMarks_For-VisargaReorder' lookup reorder_visarga;
} reorder_udatta;


#----------------------------------------------------------------------------------
# 		Lookups to substitute Ra with Reph for Vocalic vowels
#----------------------------------------------------------------------------------

lookup reph_rVocalic_01 {
#	sub raDeva' rVocMatraDeva by rVocalicDeva;
#	sub raDeva' rrVocMatraDeva by rrVocalicDeva; 
#	sub raDeva' lVocMatraDeva by lVocalicDeva;
#	sub raDeva' llVocMatraDeva by llVocalicDeva; 
} reph_rVocalic_01 ;

lookup reph_rVocalic_02 {
#	sub rVocalicDeva rVocMatraDeva' by rephDeva;
#	sub rrVocalicDeva rrVocMatraDeva' by rephDeva;
#	sub lVocalicDeva lVocMatraDeva' by rephDeva;
#	sub llVocalicDeva llVocMatraDeva' by rephDeva;
} reph_rVocalic_02 ;

lookup reph_rVocalic_03 {
#	sub [rVocalicDeva rrVocalicDeva lVocalicDeva llVocalicDeva] rephDeva' lookup reph_ligature anusvDeva' ;
#	sub [rVocalicDeva rrVocalicDeva lVocalicDeva llVocalicDeva] rephDeva' lookup reph_ligature cBinduDeva' ;
} reph_rVocalic_03 ;

lookup decompose_long_vowels {
	# (iiDeva stays whole here)
	sub aiDeva by eDeva eMatraDeva;
} decompose_long_vowels;

lookup reph_ligature_after_decomposed_ii {
	sub iDeva rephDeva' lookup reph_ligature anusvDeva';
	sub iDeva rephDeva' lookup reph_ligature cBinduDeva';
} reph_ligature_after_decomposed_ii;

lookup abvs_01 {

	sub ayMatraDeva anusvDeva by ayMatra_anusvDeva;
	sub ayMatraDeva cBinduDeva by ayMatra_cBinduDeva;
	sub ayMatraDeva reph_anusvDeva by ayMatra_reph_anusvDeva;
	sub ayMatraDeva reph_cBinduDeva by ayMatra_reph_cBinduDeva;
	sub ayMatraDeva rephDeva by ayMatra_rephDeva;

	sub oeMatraDeva anusvDeva by oeMatra_anusvDeva;
	sub oeMatraDeva cBinduDeva by oeMatra_cBinduDeva;
	sub oeMatraDeva rephDeva by oeMatra_rephDeva;
	sub oeMatraDeva reph_anusvDeva by oeMatra_reph_anusvDeva;
	sub oeMatraDeva reph_cBinduDeva by oeMatra_reph_cBinduDeva;

	sub eMatraDeva anusvDeva by eMatra_anusvDeva;
	sub eMatraDeva cBinduDeva by eMatra_cBinduDeva;
	sub eMatraDeva rephDeva by eMatra_rephDeva;
	sub eMatraDeva reph_anusvDeva by eMatra_reph_anusvDeva;
	sub eMatraDeva reph_cBinduDeva by eMatra_reph_cBinduDeva;
	
	sub aiMatraDeva anusvDeva by aiMatra_anusvDeva;
	sub aiMatraDeva cBinduDeva by aiMatra_cBinduDeva;
	sub aiMatraDeva rephDeva by aiMatra_rephDeva;
	sub aiMatraDeva reph_anusvDeva by aiMatra_reph_anusvDeva;
	sub aiMatraDeva reph_cBinduDeva by aiMatra_reph_cBinduDeva;
		
	sub eCandMatraDeva anusvDeva by eCandMatra_anusvDeva;
	sub eCandMatraDeva cBinduDeva by eCandMatra_cBinduDeva;
	sub eCandMatraDeva rephDeva by eCandMatra_rephDeva;
	sub eCandMatraDeva reph_anusvDeva by eCandMatra_reph_anusvDeva;
	sub eCandMatraDeva reph_cBinduDeva by eCandMatra_reph_cBinduDeva;
	
	sub eShMatraDeva anusvDeva by eShMatra_anusvDeva;
	sub eShMatraDeva cBinduDeva by eShMatra_cBinduDeva;
	sub eShMatraDeva rephDeva by eShMatra_rephDeva;
	sub eShMatraDeva reph_anusvDeva by eShMatra_reph_anusvDeva;
	sub eShMatraDeva reph_cBinduDeva by eShMatra_reph_cBinduDeva;
	
	sub iiMatraDeva anusvDeva by iiMatra_anusvDeva;
	sub iiMatraDeva cBinduDeva by iiMatra_cBinduDeva;
	sub iiMatraDeva rephDeva by iiMatra_rephDeva;
	sub iiMatraDeva reph_anusvDeva by iiMatra_reph_anusvDeva;
	sub iiMatraDeva reph_cBinduDeva by iiMatra_reph_cBinduDeva;
	
	# a common misspelling
	sub auDeva aiMatraDeva by auDeva;
} abvs_01 ;


