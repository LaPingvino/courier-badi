# Prefix: PositioningRules

#------------------------------------------------------------------------------------------
#				Lookups to position Above-base Vedic marks
#				Mentioned in DIST
#------------------------------------------------------------------------------------------

lookup Reposition_VedicTop {
    pos [zerocombDeva onecombDeva twocombDeva threecombDeva fourcombDeva fivecombDeva sixcombDeva sevencombDeva eightcombDeva ninecombDeva acombDeva ucombDeva kacombDeva nacombDeva pacombDeva racombDeva avagrahacombDeva karshanaVedic sharaVedic prenkhaVedic candraAboveVedic two_karshanaDeva one_raDeva two_uDeva two_raDeva two_avagrahaDeva three_kaDeva three_raDeva four_raDeva five_raDeva one_oneDeva asteriskabovecomb] <0 -558 0 0>;
    pos [vicombDeva vi_raDeva ] <0 -725 0 0>;
} Reposition_VedicTop ;

#---------------------------------------------------------------#

lookup shift_asterisk__rg {
    pos @VedicTopNumbers <-322 0 0 0>;
} shift_asterisk__rg ;


