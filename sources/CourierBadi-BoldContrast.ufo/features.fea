	sub yy_raDeva halantDeva by yy_rDeva;
	sub l_ra_nuktaDeva halantDeva by l_r_nuktaDeva;
	sub v_ra_nuktaDeva halantDeva by v_r_nuktaDeva;
	sub sh_ra_nuktaDeva halantDeva by sh_r_nuktaDeva;
	sub ss_ra_nuktaDeva halantDeva by ss_r_nuktaDeva;
	sub s_ra_nuktaDeva halantDeva by s_r_nuktaDeva;
	sub lllaDeva rakarDeva halantDeva by ll_r_nuktaDeva;		
} nuktaRakar_half_forms ;


