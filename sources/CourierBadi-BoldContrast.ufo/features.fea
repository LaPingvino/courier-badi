lookup abvs_03 { 
	sub twocombDeva karshanaVedic by two_karshanaDeva;
	sub onecombDeva racombDeva by one_raDeva;
	sub twocombDeva ucombDeva by two_uDeva;
	sub twocombDeva racombDeva by two_raDeva;
	sub twocombDeva avagrahacombDeva by two_avagrahaDeva;
	sub threecombDeva kacombDeva by three_kaDeva;
	sub threecombDeva racombDeva by three_raDeva;
	sub fourcombDeva racombDeva by four_raDeva;
	sub fivecombDeva racombDeva by five_raDeva;
	sub onecombDeva onecombDeva by one_oneDeva;
	sub vicombDeva racombDeva by vi_raDeva;
} abvs_03;


