lookup prebase_forms {
	sub tDeva taDeva by t_taDeva;
	sub tDeva tDeva by t_tDeva;
	sub nDeva naDeva by n_naDeva;
	sub pDeva naDeva by p_naDeva;
	sub bDeva dhaDeva by b_dhaDeva;
	sub vDeva yaDeva by v_yaDeva;
