lookup LekK {
    lookupflag IgnoreBaseGlyphs UseMarkFilteringSet @LekKSet;
    rsub kc.1' kcs.1 by kcs.2;
    rsub kc.1' kcs.2 by kcs.2;
    rsub [kc.2 kc.3]' [kcs.1 kcs.2] by kcs.2;
    rsub kc.1' by kcs.1;
    rsub [kc.2 kc.3]' by kcs.2;
    rsub lekS' kcs.2 by lekS.t2;
    rsub lekS' by lekS.t1;
} LekK;

lookup LekKDone {
    sub kc.1 by lekZ;
    sub kc.2 by lekZ;
    sub kc.3 by lekZ;
    sub kcs.1 by lekZ;
    sub kcs.2 by lekZ;
} LekKDone;

