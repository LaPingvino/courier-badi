#//////////////////////////////////////////////////////////////////////////////////







# Prefix: HalfFormConjunctsLookups
#------------------------------------------------------------------------------------------
#				Length-changing iMatra for Half-Form Conjuncts
#				Mentioned in PRES
#------------------------------------------------------------------------------------------

# These rules are arranged block-wise as per the Varnamala (letter order of Devanagari) of the half-forms.
# Within each block, rules are arranged in the ascending order of the widths of iMatra_Bases.


lookup iMatra_HalfFormConjuncts {

	sub iMatraDeva' @Ka_Half @Short-iMatra_02_Bases by iMatraDeva.13 ;
	sub iMatraDeva' @Ka_Half @Short-iMatra_03_Bases by iMatraDeva.14 ;
	sub iMatraDeva' @Ka_Half @Short-iMatra_04_Bases by iMatraDeva.14 ;
	sub iMatraDeva' @Ka_Half @Short-iMatra_05_Bases by iMatraDeva.14 ;
	sub iMatraDeva' @Ka_Half @Short-iMatra_06_Bases by iMatraDeva.15 ;
	sub iMatraDeva' @Ka_Half @Short-iMatra_07_Bases by iMatraDeva.15 ;	
	sub iMatraDeva' @Ka_Half @Short-iMatra_08_Bases by iMatraDeva.15 ;	
	sub iMatraDeva' @Ka_Half @Short-iMatra_09_Bases by iMatraDeva.15 ;	
	sub iMatraDeva' @Ka_Half @Short-iMatra_10_Bases by iMatraDeva.15 ;	
	sub iMatraDeva' @Ka_Half @Short-iMatra_11_Bases by iMatraDeva.15 ;	
	sub iMatraDeva' @Ka_Half @Short-iMatra_12_Bases by iMatraDeva.15 ;	#
	sub iMatraDeva' @Ka_Half @Short-iMatra_13_Bases by iMatraDeva.15 ;	#
	sub iMatraDeva' @Ka_Half @Short-iMatra_14_Bases by iMatraDeva.15 ;	#
	sub iMatraDeva' @Ka_Half @Short-iMatra_15_Bases by iMatraDeva.15 ;	#


	sub iMatraDeva' @Kha_Half @Short-iMatra_02_Bases by iMatraDeva.14 ;
	sub iMatraDeva' @Kha_Half @Short-iMatra_03_Bases by iMatraDeva.14 ;
	sub iMatraDeva' @Kha_Half @Short-iMatra_04_Bases by iMatraDeva.14 ;
	sub iMatraDeva' @Kha_Half @Short-iMatra_05_Bases by iMatraDeva.14 ;
	sub iMatraDeva' @Kha_Half @Short-iMatra_06_Bases by iMatraDeva.15 ;
	sub iMatraDeva' @Kha_Half @Short-iMatra_07_Bases by iMatraDeva.15 ;
	sub iMatraDeva' @Kha_Half @Short-iMatra_08_Bases by iMatraDeva.15 ;
	sub iMatraDeva' @Kha_Half @Short-iMatra_09_Bases by iMatraDeva.15 ;	
	sub iMatraDeva' @Kha_Half @Short-iMatra_10_Bases by iMatraDeva.15 ;	#
	sub iMatraDeva' @Kha_Half @Short-iMatra_11_Bases by iMatraDeva.15 ;	#
	sub iMatraDeva' @Kha_Half @Short-iMatra_12_Bases by iMatraDeva.15 ;	#
	sub iMatraDeva' @Kha_Half @Short-iMatra_13_Bases by iMatraDeva.15 ;	#
