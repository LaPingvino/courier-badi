	sub laDeva.MAR halantDeva by lDeva;
	sub laDeva.MAR nuktaDeva halantDeva by l_nuktaDeva;				
	sub l_raDeva.MAR halantDeva by l_rDeva;
	sub l_ra_nuktaDeva.MAR halantDeva by l_r_nuktaDeva;
} half_forms_MAR ;
