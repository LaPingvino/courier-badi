	sub hDeva' maDeva' by h_maDeva;
	sub hDeva' yaDeva' by h_yaDeva;
	sub hDeva' [laDeva laDeva.MAR]' by h_laDeva;
	sub hDeva' vaDeva' by h_vaDeva;
	sub hDeva' mDeva' yaDeva' by h_m_yaDeva;

} conjunct_forms ;


