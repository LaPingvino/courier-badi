feature locl {
script deva ;
language MAR ;
	lookup MAR_alternates {
		sub shaDeva by shaDeva.MAR;
		sub laDeva by laDeva.MAR;
	} MAR_alternates ;

language NEP ;
	lookup NEP_alternates {
		sub jhaDeva by jhaDeva.NEP;
		sub fiveDeva by fiveDeva.NEP;
		sub eightDeva by eightDeva.NEP;
	} NEP_alternates ;

language SAN ;
	lookup prebase_forms_SAN ;
	lookup blwf_rakar_forms_SAN;

script dev2 ;
language MAR ;
	lookup MAR_alternates ;

language NEP ;
	lookup NEP_alternates ;

language SAN ;
	lookup prebase_forms_SAN ;
	lookup blwf_rakar_forms_SAN;

language SAT;
    sub [aaDeva oDeva auDeva aaMatraDeva oMatraDeva auMatraDeva] nuktaDeva' by nuktaDeva.sat;

#//////////////////////////////////////////////////////////////////////////////////

} locl;

feature nukt {
#----------------------------------------------------------------------------------
# 		Lookups for Unicode Nukta Forms
#----------------------------------------------------------------------------------


lookup nukta_forms {
	sub kaDeva nuktaDeva by qaDeva;
	sub khaDeva nuktaDeva by khhaDeva;
	sub gaDeva nuktaDeva by ghhaDeva;
	sub jaDeva nuktaDeva by zaDeva;
	sub ddaDeva nuktaDeva by dddhaDeva;
	sub ddhaDeva nuktaDeva by rhaDeva;
	sub naDeva nuktaDeva by nnnaDeva;
	sub phaDeva nuktaDeva by faDeva;
	sub yaDeva nuktaDeva by yyaDeva;
	sub raDeva nuktaDeva by rraDeva;
	sub llaDeva nuktaDeva by lllaDeva;
} nukta_forms ;



#//////////////////////////////////////////////////////////////////////////////////

} nukt;

feature akhn {
lookup akhand_forms {
	sub kaDeva halantDeva ssaDeva by k_ssaDeva;
	sub jaDeva halantDeva nyaDeva by j_nyaDeva;
} akhand_forms ;

lookup eyelash_reph {
	ignore sub halantDeva raDeva' halantDeva' uni200D';
	sub raDeva' lookup eyelashRa halantDeva' uni200D';
} eyelash_reph ;


#//////////////////////////////////////////////////////////////////////////////////

} akhn;

feature rphf {
