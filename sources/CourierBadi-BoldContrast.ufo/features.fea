lookup DevaWordEnd {
    lookupflag IgnoreMarks;
    ignore sub @DevaFinaIn' @DevaJoinsLeft;
    ignore sub @DevaIsolIn' @DevaJoinsLeft;
    sub @DevaFinaIn' by @DevaFinaOut;
    sub @DevaIsolIn' by @DevaIsolOut;
} DevaWordEnd;

@DevaCellMarks = [NullMark.cell NullMark.cell.fina];
@DevaCellIn = [NullMark.cell];
@DevaCellOut = [NullMark.cell.fina];
lookup DevaCellWordEnd {
    lookupflag UseMarkFilteringSet @DevaCellMarks;
    ignore sub @DevaCellIn' @DevaJoinsLeft;
    ignore sub @DevaCellIn' @DevaCellMarks;
    sub @DevaCellIn' by @DevaCellOut;
} DevaCellWordEnd;

feature psts {
    lookup DevaCellAfter;
    lookup DevaIMatraCells;
    lookup DevaPackSub;
} psts;

feature calt {
    lookup DevaWordStart;
    lookup DevaWordEnd;
    lookup DevaCellWordEnd;
} calt;

