	sub iMatraDeva.13' lookup iMatra_reph_candraBindu @Short-iMatra_13_Bases' reph_cBinduDeva' lookup DeleteMark;
	sub iMatraDeva.14' lookup iMatra_reph_candraBindu @Short-iMatra_14_Bases' reph_cBinduDeva' lookup DeleteMark;
	sub iMatraDeva.15' lookup iMatra_reph_candraBindu @Short-iMatra_15_Bases' reph_cBinduDeva' lookup DeleteMark;

} iMatra_reph_candraBindu_basic ;


lookup iMatra_anusvara_HalfFormConjuncts ;
lookup iMatra_candraBindu_HalfFormConjuncts ;
lookup iMatra_reph_HalfFormConjuncts ;
lookup iMatra_reph_anusvara_HalfFormConjuncts ;
lookup iMatra_reph_candraBindu_HalfFormConjuncts ;




#//////////////////////////////////////////////////////////////////////////////////


} abvs;

feature blws {


#----------------------------------------------------------------------------------
#		Lookup to swap Visarga & Anudatta
#----------------------------------------------------------------------------------

lookup reorder_anudatta {
	sub visargaDeva' lookup visarga_to_NullMark anudattaDeva' lookup reorder_visarga;
} reorder_anudatta;



#----------------------------------------------------------------------------------
#		Lookups for Consonant + Below-base Mark glyphs
#----------------------------------------------------------------------------------

lookup blws_01 {
	sub daDeva nuktaDeva' lookup nukta_to_uMatra uMatraDeva' lookup matra_to_nukta ;
	sub daDeva nuktaDeva' lookup nukta_to_uuMatra uuMatraDeva' lookup matra_to_nukta ;
	sub daDeva nuktaDeva' lookup nukta_to_rMatra rVocMatraDeva' lookup matra_to_nukta ;
	sub haDeva nuktaDeva' lookup nukta_to_rMatra rVocMatraDeva' lookup matra_to_nukta ;
	sub haDeva nuktaDeva' lookup nukta_to_rrMatra rrVocMatraDeva' lookup matra_to_nukta ;
} blws_01 ;

lookup blws_02 {
	sub raDeva uMatraDeva by ra_uMatraDeva;
	sub raDeva uuMatraDeva by ra_uuMatraDeva;
	sub rraDeva uMatraDeva by ra_uMatra_nuktaDeva;
	sub rraDeva uuMatraDeva by ra_uuMatra_nuktaDeva;
	sub daDeva uMatraDeva by da_uMatraDeva;
	sub daDeva uuMatraDeva by da_uuMatraDeva;
	sub daDeva rVocMatraDeva by da_rVocMatraDeva;
	sub [shaDeva shaDeva.MAR] rVocMatraDeva by sha_rVocMatraDeva;
	sub haDeva uMatraDeva by ha_uMatraDeva;
	sub haDeva uuMatraDeva by ha_uuMatraDeva;
	sub haDeva rVocMatraDeva by ha_rVocMatraDeva;
	sub haDeva rrVocMatraDeva by ha_rrVocMatraDeva;
	sub haDeva nuktaDeva uMatraDeva by ha_uMatra_nuktaDeva;						
	sub haDeva nuktaDeva uuMatraDeva by ha_uuMatra_nuktaDeva;					
	sub h_raDeva uMatraDeva by h_ra_uMatraDeva;
	sub h_raDeva uuMatraDeva by h_ra_uuMatraDeva;
} blws_02 ;


#----------------------------------------------------------------------------------
#			Lookup for Composite Below-base Marks
#----------------------------------------------------------------------------------

lookup blws_03 {

	sub rakarDeva uMatraDeva by rakar_uMatraDeva;
	sub rakarDeva uuMatraDeva by rakar_uuMatraDeva;
	sub rakarDeva rVocMatraDeva by rakar_rVocMatraDeva;
	sub rakarDeva rrVocMatraDeva by rakar_rrVocMatraDeva;
	sub rakarDeva lVocMatraDeva by rakar_lVocMatraDeva;
	sub rakarDeva llVocMatraDeva by rakar_llVocMatraDeva;
	sub rakarDeva ueMatraDeva by rakar_ueMatraDeva;
	sub rakarDeva uueMatraDeva by rakar_uueMatraDeva;
	sub rakarDeva halantDeva by rakar_halantDeva;

	sub nuktaDeva rakarDeva by nukta_rakarDeva;
	sub nuktaDeva rakarDeva uMatraDeva by nukta_rakar_uMatraDeva;
	sub nuktaDeva rakarDeva uuMatraDeva by nukta_rakar_uuMatraDeva;
	sub nuktaDeva rakarDeva rVocMatraDeva by nukta_rakar_rVocMatraDeva;
	sub nuktaDeva rakarDeva rrVocMatraDeva by nukta_rakar_rrVocMatraDeva;
	sub nuktaDeva rakarDeva lVocMatraDeva by nukta_rakar_lVocMatraDeva;
	sub nuktaDeva rakarDeva llVocMatraDeva by nukta_rakar_llVocMatraDeva;
	sub nuktaDeva rakarDeva ueMatraDeva by nukta_rakar_ueMatraDeva;
	sub nuktaDeva rakarDeva uueMatraDeva by nukta_rakar_uueMatraDeva;
	sub nuktaDeva rakarDeva halantDeva by nukta_rakar_halantDeva;

} blws_03 ;



#----------------------------------------------------------------------------------
#			Lookups for context dependent Base glyphs & Below-base Marks
#----------------------------------------------------------------------------------

lookup blws_04 {

# Nukta + Below-base Mark combinations --------------------------------------------------
	sub [dddhaDeva rhaDeva lllaDeva]' lookup nukta_consonant_split [uMatraDeva uuMatraDeva ueMatraDeva uueMatraDeva]' lookup matra_to_nuktaMatra_split;

	sub [dddhaDeva rhaDeva lllaDeva]' lookup nukta_consonant_split [rakarDeva rakar_uMatraDeva rakar_uuMatraDeva rakar_ueMatraDeva rakar_uueMatraDeva rakar_rVocMatraDeva rakar_rrVocMatraDeva rakar_lVocMatraDeva rakar_llVocMatraDeva rakar_halantDeva]' lookup matra_to_nuktaMatraLigature;


	sub [ghaDeva ngaDeva caDeva chaDeva c_chaDeva nyaDeva ttaDeva tthaDeva nnaDeva taDeva thaDeva dhaDeva paDeva baDeva bhaDeva maDeva laDeva laDeva.MAR vaDeva ssaDeva haDeva] nuktaDeva' lookup nukta_matra_ligatures [lVocMatraDeva llVocMatraDeva]';

	sub [taDeva laDeva laDeva.MAR haDeva] nuktaDeva' lookup nukta_matra_ligatures [uMatraDeva uuMatraDeva ueMatraDeva uueMatraDeva rVocMatraDeva rrVocMatraDeva lVocMatraDeva llVocMatraDeva]';

	sub [ngaDeva chaDeva c_chaDeva ttaDeva tthaDeva ss_ttaDeva ss_tthaDeva] nuktaDeva' lookup nukta_matra_ligatures [rVocMatraDeva rrVocMatraDeva lVocMatraDeva llVocMatraDeva rakarDeva halantDeva]';

	sub [ghaDeva caDeva nnaDeva thaDeva dhaDeva nyaDeva baDeva bhaDeva maDeva vaDeva ssaDeva haDeva] nuktaDeva' lookup nukta_matra_ligatures [ueMatraDeva uueMatraDeva]' ;


	sub [qaDeva ghhaDeva zaDeva nnnaDeva faDeva yyaDeva dddhaDeva rhaDeva rraDeva lllaDeva]' lookup nukta_consonant_split [lVocMatraDeva llVocMatraDeva]' lookup matra_to_nuktaMatraLigature ;

	sub [dddhaDeva rhaDeva lllaDeva]' lookup nukta_consonant_split [rVocMatraDeva rrVocMatraDeva halantDeva]' lookup matra_to_nuktaMatraLigature ;

	sub [ghhaDeva zaDeva nnnaDeva yyaDeva]' lookup nukta_consonant_split [ueMatraDeva uueMatraDeva]' lookup matra_to_nuktaMatraLigature ;

	sub [ngaDeva chaDeva c_chaDeva ttaDeva tthaDeva ss_ttaDeva ss_tthaDeva] nuktaDeva' lookup belowBaseMatra_alternate [uMatraDeva uuMatraDeva ueMatraDeva uueMatraDeva]' lookup belowBaseMatra_alternate;


# Alternate uMatra, uuMatra --------------------------------------------------
	sub [qaDeva ghhaDeva zaDeva zhaDeva nnnaDeva faDeva yyaDeva shaDeva.MAR jhaDeva jh_raDeva jh_ra_nuktaDeva zh_raDeva d_raDeva h_nnaDeva h_naDeva h_laDeva] uMatraDeva' by uMatra_NarrowDeva;

	sub [ghaDeva caDeva jhaDeva nyaDeva nnaDeva thaDeva dhaDeva paDeva baDeva bhaDeva maDeva vaDeva ssaDeva] nuktaDeva uMatraDeva' by uMatra_NarrowDeva;

	sub [tt_ttaDeva tt_tthaDeva dd_ddaDeva tth_tthaDeva dd_ddhaDeva ddh_ddhaDeva ng_kaDeva ng_khaDeva ng_gaDeva ng_ghaDeva ng_maDeva c_ch_vaDeva ch_vaDeva] [uMatraDeva uuMatraDeva]' lookup belowBaseMatra_alternate;

} blws_04 ;


lookup blws_05 {

	sub @ShortDandaConsonants' lookup short_danda_consonant_alternates [rakar_rrVocMatraDeva rakar_lVocMatraDeva rakar_llVocMatraDeva nukta_rakar_rrVocMatraDeva nukta_rakar_lVocMatraDeva nukta_rakar_llVocMatraDeva];

	sub @NuktaRakarForms' lookup nuktaRakar_to_rakar_consonants [uMatraDeva uuMatraDeva rVocMatraDeva rrVocMatraDeva lVocMatraDeva llVocMatraDeva ueMatraDeva uueMatraDeva]' lookup matra_to_nuktaMatraLigature ;

} blws_05 ;


#----------------------------------------------------------------------------------
# 		Lookup for alternate Vedic_Below-base Marks
#----------------------------------------------------------------------------------


lookup blws_06 {

	sub @ShortDandaConsonants_alt [rakar_uMatraDeva rakar_uuMatraDeva rakar_rrVocMatraDeva rakar_lVocMatraDeva rakar_llVocMatraDeva]' lookup UI_alternates @VedicBelow_default' lookup belowBaseMatra_alternate;

	sub @ShortDandaConsonants' lookup short_danda_consonant_alternates [rakar_uMatraDeva rakar_uuMatraDeva rakar_rVocMatraDeva]' @VedicBelow_default' lookup belowBaseMatra_alternate;

	sub [haDeva h_raDeva]' lookup short_danda_consonant_alternates [rVocMatraDeva rrVocMatraDeva lVocMatraDeva llVocMatraDeva]' lookup belowBaseMatra_alternate @VedicBelow_default' lookup belowBaseMatra_alternate;

	sub [haDeva h_raDeva] [rrVocMatraDeva lVocMatraDeva llVocMatraDeva nukta_rrVocMatraDeva nukta_lVocMatraDeva nukta_llVocMatraDeva]' lookup belowBaseMatra_alternate ;

	sub [rrVocMatraDeva lVocMatraDeva llVocMatraDeva]' lookup belowBaseMatra_alternate @VedicBelow_default' lookup belowBaseMatra_alternate;

	sub [uMatraDeva uuMatraDeva rVocMatraDeva rakarDeva uMatra_NarrowDeva nukta_uMatraDeva nukta_uuMatraDeva nukta_rVocMatraDeva nukta_rrVocMatraDeva nukta_lVocMatraDeva nukta_llVocMatraDeva nukta_rakarDeva] @VedicBelow_default' lookup belowBaseMatra_alternate;

	sub [ha_uMatraDeva ha_uuMatraDeva h_ra_uMatraDeva h_ra_uuMatraDeva]' lookup UI_alternates @VedicBelow_default' lookup belowBaseMatra_alternate;

	sub [ha_uMatra_nuktaDeva ha_uuMatra_nuktaDeva] @VedicBelow_default' lookup belowBaseMatra_alternate;

# Alternate Vedic_BelowMarks preceeded by Below-base Marks & PostBase Matras ------------------------------- 
	sub @VedicBelowAlt_Bases-01 [rakarDeva nukta_rakarDeva] @PostBaseMarks_For-VedicBelowAlt @VedicBelow_default' lookup belowBaseMatra_alternate;
	sub @VedicBelowAlt_Bases-02 @PostBaseMarks_For-VedicBelowAlt @VedicBelow_default' lookup belowBaseMatra_alternate;

# Alternate Vedic_BelowMarks preceeded by Below-base Marks, PostBase Matras & Above-base Marks --------------
 	sub @VedicBelowAlt_Bases-01 [rakarDeva nukta_rakarDeva] [aaMatraDeva] @AboveMarks_For-VedicBelowAlt @VedicBelow_default' lookup belowBaseMatra_alternate;
	sub @VedicBelowAlt_Bases-02 [aaMatraDeva] @AboveMarks_For-VedicBelowAlt @VedicBelow_default' lookup belowBaseMatra_alternate;

	sub [d_bhaDeva d_daDeva]' lookup short_danda_consonant_alternates [uMatraDeva uuMatraDeva rVocMatraDeva]' @VedicBelow_default' lookup belowBaseMatra_alternate;

	sub haDeva [lVocMatraDeva.alt llVocMatraDeva.alt] @VedicBelow_alt01' by @VedicBelow_default;
	sub haDeva [lVocMatraDeva.alt llVocMatraDeva.alt] @AboveMarks_For-VedicBelowAlt @VedicBelow_alt01' by @VedicBelow_default;

} blws_06 ; 





#//////////////////////////////////////////////////////////////////////////////////


} blws;

feature psts {

#----------------------------------------------------------------------------------
#				Lookup for alternate Above-base Vedic Marks 
#				in context of iMatra & Composite iMatras
#----------------------------------------------------------------------------------

lookup vedicTop_for_Composite_iMatra_01 {

	sub @All_Short-iMatra_normal @All_BaseGlyphs @VedicTop_default' by @VedicTop_alt01;
	sub @All_Short-iMatra_normal @All_HalfForms @All_BaseGlyphs @VedicTop_default' by @VedicTop_alt01;
	sub @All_Short-iMatra_anusvara @All_BaseGlyphs NullMark @VedicTop_default' by @VedicTop_alt02;
	sub @All_Short-iMatra_anusvara @All_HalfForms @All_BaseGlyphs NullMark @VedicTop_default' by @VedicTop_alt02;
	sub @All_Short-iMatra_candraBindu @All_BaseGlyphs NullMark @VedicTop_default' by @VedicTop_alt03;
	sub @All_Short-iMatra_candraBindu @All_HalfForms @All_BaseGlyphs NullMark @VedicTop_default' by @VedicTop_alt03;
	sub [@All_Short-iMatra_reph @All_Short-iMatra_reph_anusvara] @All_BaseGlyphs NullMark @VedicTop_default' by @VedicTop_alt04;
	sub [@All_Short-iMatra_reph @All_Short-iMatra_reph_anusvara] @All_HalfForms @All_BaseGlyphs NullMark @VedicTop_default' by @VedicTop_alt04;
	sub @All_Short-iMatra_reph_candraBindu @All_BaseGlyphs NullMark @VedicTop_default' by @VedicTop_alt05;
	sub @All_Short-iMatra_reph_candraBindu @All_HalfForms @All_BaseGlyphs NullMark @VedicTop_default' by @VedicTop_alt05;


 # WITH Below-base Marks in the input string -----------------------------------------------

	sub @All_Short-iMatra_normal @All_BaseGlyphs @BelowMarks_For-VedicTopAlt @VedicTop_default' by @VedicTop_alt01;
	sub @All_Short-iMatra_normal @All_HalfForms @All_BaseGlyphs @BelowMarks_For-VedicTopAlt @VedicTop_default' by @VedicTop_alt01;
	sub @All_Short-iMatra_anusvara @All_BaseGlyphs @BelowMarks_For-VedicTopAlt NullMark @VedicTop_default' by @VedicTop_alt02;
	sub @All_Short-iMatra_anusvara @All_HalfForms @All_BaseGlyphs @BelowMarks_For-VedicTopAlt NullMark @VedicTop_default' by @VedicTop_alt02;
	sub @All_Short-iMatra_candraBindu @All_BaseGlyphs @BelowMarks_For-VedicTopAlt NullMark @VedicTop_default' by @VedicTop_alt03;
	sub @All_Short-iMatra_candraBindu @All_HalfForms @All_BaseGlyphs @BelowMarks_For-VedicTopAlt NullMark @VedicTop_default' by @VedicTop_alt03;
	sub [@All_Short-iMatra_reph @All_Short-iMatra_reph_anusvara] @All_BaseGlyphs @BelowMarks_For-VedicTopAlt NullMark @VedicTop_default' by @VedicTop_alt04;
	sub [@All_Short-iMatra_reph @All_Short-iMatra_reph_anusvara] @All_HalfForms @All_BaseGlyphs @BelowMarks_For-VedicTopAlt NullMark @VedicTop_default' by @VedicTop_alt04;
	sub @All_Short-iMatra_reph_candraBindu @All_BaseGlyphs @BelowMarks_For-VedicTopAlt NullMark @VedicTop_default' by @VedicTop_alt05;
	sub @All_Short-iMatra_reph_candraBindu @All_HalfForms @All_BaseGlyphs @BelowMarks_For-VedicTopAlt NullMark @VedicTop_default' by @VedicTop_alt05;

} vedicTop_for_Composite_iMatra_01 ;


#----------------------------------------------------------------------------------
#				Lookup to correct the position of alternate Above-base Vedic Marks 
#				on select conjuncts
#----------------------------------------------------------------------------------

lookup vedicTop_for_Composite_iMatra_02 {

#----------------------------------------------------------------------------------
	sub @All_Short-iMatra_normal [ng_yaDeva ch_yaDeva d_dh_yaDeva] @VedicTop_alt01' by @VedicTop_default ;
	sub @All_Short-iMatra_anusvara [@Sa_Half] [maDeva m_raDeva m_ra_nuktaDeva] @VedicTop_alt01' by @VedicTop_default ;

#----------------------------------------------------------------------------------
	sub @All_Short-iMatra_anusvara [ng_yaDeva ch_yaDeva d_dh_yaDeva] NullMark @VedicTop_alt02' by @VedicTop_alt01 ;
	sub @All_Short-iMatra_anusvara [@Sa_Half] [maDeva m_raDeva m_ra_nuktaDeva] NullMark @VedicTop_alt02' by @VedicTop_alt01 ;

	sub @All_Short-iMatra_anusvara [@La_Half] [yaDeva y_raDeva jaDeva j_raDeva maDeva m_raDeva shaDeva shaDeva.MAR] NullMark @VedicTop_alt02' by @VedicTop_alt01 ;

#----------------------------------------------------------------------------------
	sub @All_Short-iMatra_candraBindu [ng_yaDeva ch_yaDeva d_dh_yaDeva] NullMark @VedicTop_alt03' by @VedicTop_alt02 ;
	sub @All_Short-iMatra_candraBindu [@Sa_Half] [maDeva m_raDeva m_ra_nuktaDeva] NullMark @VedicTop_alt03' by @VedicTop_alt02 ;

	sub @All_Short-iMatra_candraBindu [@La_Half] [yaDeva y_raDeva jaDeva j_raDeva maDeva m_raDeva shaDeva shaDeva.MAR] NullMark @VedicTop_alt03' by @VedicTop_alt02 ;

#----------------------------------------------------------------------------------
	sub @All_Short-iMatra_reph [ng_yaDeva ch_yaDeva d_dh_yaDeva] NullMark @VedicTop_alt04' by @VedicTop_alt03 ;
	sub @All_Short-iMatra_reph [@Sa_Half] [maDeva m_raDeva m_ra_nuktaDeva] NullMark @VedicTop_alt04' by @VedicTop_alt03 ;

	sub @All_Short-iMatra_reph [@La_Half] [yaDeva y_raDeva jaDeva j_raDeva maDeva m_raDeva shaDeva shaDeva.MAR] NullMark @VedicTop_alt04' by @VedicTop_alt03 ;

#----------------------------------------------------------------------------------
	sub @All_Short-iMatra_reph_anusvara [ng_yaDeva ch_yaDeva d_dh_yaDeva] NullMark @VedicTop_alt04' by @VedicTop_alt03 ;
	sub @All_Short-iMatra_reph_anusvara [@Sa_Half] [maDeva m_raDeva m_ra_nuktaDeva] NullMark @VedicTop_alt04' by @VedicTop_alt03 ;

	sub @All_Short-iMatra_reph_anusvara [@La_Half] [yaDeva y_raDeva jaDeva j_raDeva maDeva m_raDeva shaDeva shaDeva.MAR] NullMark @VedicTop_alt04' by @VedicTop_alt03 ;

#----------------------------------------------------------------------------------
	sub @All_Short-iMatra_reph_candraBindu [ng_yaDeva ch_yaDeva d_dh_yaDeva] NullMark @VedicTop_alt05' by @VedicTop_alt04 ;
	sub [@All_Short-iMatra_reph @All_Short-iMatra_reph_anusvara] [@Sa_Half] [maDeva m_raDeva m_ra_nuktaDeva] NullMark @VedicTop_alt04' by @VedicTop_alt03 ;

	sub @All_Short-iMatra_reph_candraBindu [@La_Half] [yaDeva y_raDeva jaDeva j_raDeva maDeva m_raDeva shaDeva shaDeva.MAR] NullMark @VedicTop_alt05' by @VedicTop_alt04 ;

} vedicTop_for_Composite_iMatra_02 ;

#----------------------------------------------------------------------------------
#				Lookup for alternate atharvavedicIndependentSvarita-vedic
#----------------------------------------------------------------------------------

lookup psts_01 {

	sub [d_baDeva d_bhaDeva d_daDeva d_dhaDeva d_gaDeva d_ghaDeva d_vaDeva baDeva b_dhaDeva b_raDeva bhaDeva bh_raDeva caDeva c_raDeva ch_yaDeva d_d_yaDeva daDeva d_maDeva d_raDeva d_v_yaDeva d_yaDeva ddaDeva dd_r_yaDeva dd_yaDeva ddhaDeva ddh_yaDeva dhaDeva dh_raDeva gaDeva g_raDeva ghaDeva gh_raDeva haDeva h_raDeva jaDeva j_nyaDeva j_ny_raDeva j_raDeva jhaDeva jh_raDeva k_ssaDeva k_ss_raDeva khaDeva kh_raDeva laDeva l_raDeva maDeva m_raDeva naDeva n_naDeva nnnaDeva nnn_raDeva n_raDeva ng_yaDeva nnaDeva nn_raDeva nyaDeva ny_raDeva paDeva p_naDeva p_raDeva phaDeva ph_raDeva saDeva s_raDeva shaDeva sh_laDeva sh_naDeva sh_caDeva sh_vaDeva sh_raDeva ssaDeva ss_raDeva ss_tt_yaDeva ss_tth_yaDeva taDeva t_raDeva t_taDeva thaDeva th_raDeva ttaDeva tt_yaDeva tthaDeva tth_yaDeva vaDeva v_raDeva v_yaDeva yaDeva y_raDeva shaDeva.MAR sha_rVocMatraDeva laDeva.MAR l_raDeva.MAR] [uMatraDeva uMatra_NarrowDeva uuMatraDeva rVocMatraDeva rrVocMatraDeva lVocMatraDeva llVocMatraDeva] avIndSvarVedic' by avIndSvarVedic.alt;

	sub [d_baDeva d_bhaDeva d_daDeva d_dhaDeva d_gaDeva d_ghaDeva d_vaDeva rVocalicDeva rrVocalicDeva lVocalicDeva llVocalicDeva ng_kaDeva ng_khaDeva ng_gaDeva ng_ghaDeva ng_maDeva c_ch_vaDeva ch_vaDeva tt_ttaDeva tt_tthaDeva tth_tthaDeva dd_ddaDeva dd_ddhaDeva ddh_ddhaDeva h_nnaDeva h_naDeva h_maDeva h_yaDeva h_laDeva h_vaDeva] avIndSvarVedic' by avIndSvarVedic.alt;

} psts_01 ; 


#----------------------------------------------------------------------------------
#		Lookups for visarga_svarita, visarga.alt & to re-order VedicVisarga
#----------------------------------------------------------------------------------

lookup vedicVisarga_01 {
	sub visargaDeva visargaSvarVedic by visarga_svarita;
} vedicVisarga_01;


lookup vedicVisarga_02 {
	sub visargaDeva' [visargaUdattaVedic reversedVisargaUdattaVedic visargaAnudattaVedic reversedVisargaAnudattaVedic visargaUdattaTailVedic visargaAnudattaTailVedic] by visargaDeva.alt;
} vedicVisarga_02 ;


lookup reorder_vedic_visarga {
	sub visargaDeva.alt' lookup visarga_to_NullMark [reversedVisargaUdattaVedic visargaAnudattaVedic visargaAnudattaTailVedic]' lookup reorder_visarga;
} reorder_vedic_visarga;

#----------------------------------------------------------------------------------
#				Lookup for iiMatra & Composite iiMatras
#----------------------------------------------------------------------------------

lookup psts_02 {
lookupflag IgnoreMarks ;
	sub @Long-iiMatra_01_Bases @Long-iiMatra_default' by @Long-iiMatra_01 ;
	sub @Long-iiMatra_02_Bases @Long-iiMatra_default' by @Long-iiMatra_02 ;
	sub @Long-iiMatra_03_Bases @Long-iiMatra_default' by @Long-iiMatra_03 ;
} psts_02 ;





#//////////////////////////////////////////////////////////////////////////////////

} psts;

feature dist {
# Automatic Code Start

#----------------------------------------------------------------------------------
#				Lookups to avoid clashing of Above-base Vedic marks
#----------------------------------------------------------------------------------

# Done, But need to do for All masters

lookup AvoidVedicTopMarkClash_01 {
    pos [space uni25CC] @VedicTopNumbers' lookup Reposition_VedicTop;
    pos [space uni25CC] asteriskabovecomb' lookup Reposition_VedicTop;
    pos [space uni25CC] [@VedicTopNumbers asteriskabovecomb] asteriskabovecomb' lookup Reposition_VedicTop;
} AvoidVedicTopMarkClash_01;


lookup AvoidVedicTopMarkClash_02 {
    pos @VedicTopNumbers' lookup shift_asterisk__rg asteriskabovecomb;
} AvoidVedicTopMarkClash_02;


lookup AvoidVedicTopMarkClash_03 { 
	pos @VedicTopNumbers' <-193 0 0 0> raDeva' @VedicTopNumbers' <96 0 0 0>;
} AvoidVedicTopMarkClash_03;



#//////////////////////////////////////////////////////////////////////////////////

} dist;

feature ss02 {
featureNames {
  name "Alternate numeral forms";
};
	sub nineDeva by nineDeva.NEP;

