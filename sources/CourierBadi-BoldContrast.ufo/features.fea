	sub ssDeva tthaDeva halantDeva yaDeva by ss_tth_yaDeva;
	sub kDeva taDeva by k_taDeva.SAN;
} prebase_forms_NEP ;

lookup prebase_forms_MAR {
	sub shDeva.MAR laDeva.MAR by sh_laDeva.MAR;
