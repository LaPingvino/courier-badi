lookup HalfForm_alternates {
	sub nDeva' [dhaDeva dh_raDeva dh_ra_nuktaDeva dhDeva dh_rDeva dh_r_nuktaDeva thaDeva th_raDeva th_ra_nuktaDeva thDeva th_rDeva th_r_nuktaDeva] by nDeva.alt ;
	sub [jDeva zDeva]' [jaDeva zhaDeva j_raDeva z_raDeva jDeva j_rDeva z_rDeva zDeva] by [jDeva.alt zDeva.alt] ;
	sub mDeva' [bhaDeva bh_raDeva bh_nuktaDeva bh_rDeva bh_r_nuktaDeva jhaDeva.NEP jh_raDeva.NEP jhDeva.NEP jh_rDeva.NEP jh_r_nuktaDeva.NEP ] by mDeva.alt ;

} HalfForm_alternates;

