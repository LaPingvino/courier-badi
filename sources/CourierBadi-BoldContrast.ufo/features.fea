# Prefix: IndependentLookups
# ------------------------------------------------------------------
# 			Lookups used in AKHN
# ------------------------------------------------------------------

lookup eyelashRa {
	sub raDeva halantDeva uni200D by eyelashRephDeva;
} eyelashRa ;

# ------------------------------------------------------------------
# 			Lookups for Vowels with Composite Above-base Marks
# ------------------------------------------------------------------

lookup a_vowel {
	sub [aCandraDeva aShortDeva oeDeva] by aDeva;
} a_vowel ;

lookup e_vowel {
	sub [aiDeva eCandDeva eShDeva] by eDeva;
} e_vowel ;

lookup aa_vowel {
	sub [oDeva auDeva oCandraDeva oShortDeva ooeDeva awDeva] by aaDeva;
} aa_vowel ;

lookup i_vowel {
	sub [iiDeva] by iDeva;
} i_vowel ;


# ------------------------------------------------------------------
# 			Lookups for Above-Base Marks + Anusvara
# ------------------------------------------------------------------

lookup aa_matra {
	sub [oMatraDeva auMatraDeva oCandraMatraDeva oShortMatraDeva ooeMatraDeva awMatraDeva] by aaMatraDeva;
} aa_matra ;

lookup eMatra_anusvara {
	sub anusvDeva by eMatra_anusvDeva;
} eMatra_anusvara ;

lookup eShortMatra_anusvara {
	sub anusvDeva by eShMatra_anusvDeva;
} eShortMatra_anusvara ;

